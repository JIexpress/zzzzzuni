  _rows:
  - <Id>k__BackingField: Q01
    <Name>k__BackingField: "\u53CC\u6CB3\u539F\u7684\u6D47\u704C\u987A\u5E8F"
    <Trigger>k__BackingField: "\u65F1\u5B63\u8FDB\u5165\u7B2C\u4E8C\u4E2A\u6708\uFF0C\u84C4\u6C34\u5C42\u964D\u5230\u8B66\u6212\u7EBF\uFF0C\u53CC\u6CB3\u539F\u519C\u6237\u8054\u540D\u6765\u627E\u73A9\u5BB6\u6392\u704C\u6E89\u987A\u5E8F\u3002"
    <Involved>k__BackingField: "\u519C\u827A\u5E08\u8D3A\u8FDE\u751F\uFF08\u60F3\u4FDD\u4F4F\u7B2C\u4E00\u5B63\u7A3B\uFF0C\u4E3B\u5F20\u5148\u6D47\u7530\uFF09\uFF1B\u6C34\u8D28\u51C0\u5316\u7AD9\u7AD9\u957F\u8001\u5D14\uFF08\u60F3\u5148\u4FDD\u996E\u7528\u6C34\uFF0C\u4E3B\u5F20\u5148\u4FDD\u4EBA\uFF09\uFF1B\u8001\u6237\u4EE3\u8868\u79E6\u963F\u5A46\uFF08\u60F3\u8BA9\u8001\u6237\u5148\u6D47\uFF0C\u5F53\u5E74\u662F\u5979\u5E26\u5934\u5F00\u57A6\u8FD9\u7247\u7530\uFF09"
    <Core>k__BackingField: "\u540C\u4E00\u80A1\u6C34\u6D47\u4E86\u7530\u5C31\u4E0D\u591F\u4EBA\u559D\uFF0C\u5148\u6D47\u8C01\u90FD\u662F\u62FF\u53E6\u4E00\u8FB9\u7684\u751F\u8BA1\u62BC\u6CE8\u3002"
    <OptionA>k__BackingField: "\u6309\u767B\u8BB0\u987A\u5E8F\u5148\u7530\u540E\u4EBA\uFF08\u519C\u6237\u7684\u7A3B\u7530\u4FDD\u4F4F\u5927\u534A\uFF0C\u4F46\u51C0\u5316\u7AD9\u4EA7\u80FD\u8DDF\u4E0D\u4E0A\uFF0C\u4E09\u5468\u540E\u996E\u7528\u6C34\u5F00\u59CB\u63BA\u56DE\u7528\u6C34\uFF0C\u62C9\u809A\u5B50\u7684\u5B69\u5B50\u589E\u591A\uFF09"
    <OptionB>k__BackingField: "\u996E\u6C34\u7EDD\u5BF9\u4F18\u5148\uFF0C\u7530\u5730\u53EA\u51C6\u591C\u95F4\u6D47\u534A\u91CF\uFF08\u4EBA\u559D\u7684\u591F\u4E86\uFF0C\u6536\u6210\u9884\u8BA1\u51CF\u534A\uFF0C\u519C\u6237\u626C\u8A00\u8981\u81EA\u6253\u4E95\uFF0C\u4E95\u4F4D\u82E5\u6253\u7A7F\u54B8\u6C34\u5C42\u6574\u7247\u5730\u4E0B\u6C34\u90FD\u5E9F\uFF09"
    <OptionC>k__BackingField: "\u6536\u9636\u68AF\u6C34\u7A0E\uFF0C\u6309\u7528\u91CF\u7ADE\u4EF7\u4F9B\u6C34\uFF08\u6C34\u7AD9\u6709\u94B1\u6362\u6EE4\u82AF\uFF0C\u957F\u671F\u6700\u5E72\u51C0\uFF1B\u4F46\u6700\u7A77\u7684\u4E09\u6237\u76F4\u63A5\u9000\u51FA\u6D47\u6C34\u6539\u5403\u5B58\u7CAE\uFF0C\u79CB\u540E\u8FD9\u4E24\u4E09\u6237\u8981\u6328\u997F\uFF09"
    <Aftermath>k__BackingField: "\uFF0C\u79CB\u6536\u7F3A\u53E3\u5151\u73B0\uFF0C\u539F\u4E0A\u7CAE\u4EF7\u7FFB\u500D\uFF0C\u914D\u7ED9\u7AD9\u95E8\u53E3\u6392\u8D77\u957F\u961F\uFF0C\u5F53\u521D\u6CA1\u6D47\u4E0A\u6C34\u7684\u90A3\u51E0\u6237\u662F\u9A82\u58F0\u6700\u5927\u7684\u3002"
    <DelayMonths>k__BackingField: 3
    <WorldAdvances>k__BackingField: 1
  - <Id>k__BackingField: Q02
    <Name>k__BackingField: "\u4E00\u4E2A\u8001\u5E08\u7684\u8BFE\u65F6\u8868"
    <Trigger>k__BackingField: "\u77FF\u533A\u7684\u516C\u529E\u6559\u5E08\u63D0\u524D\u79BB\u804C\uFF0C\u5B66\u6821\u53EA\u5269\u4E00\u540D\u80FD\u6559\u9AD8\u5E74\u7EA7\u7684\u8001\u5E08\uFF0C\u65B0\u8BFE\u65F6\u8868\u8981\u73A9\u5BB6\u62CD\u677F\u3002"
    <Involved>k__BackingField: "\u9AD8\u5E74\u7EA7\u6559\u5E08\u6E29\u8001\u5E08\uFF08\u60F3\u4FDD\u4F4F\u5468\u516D\u4F11\u606F\uFF0C\u4E0D\u7136\u6491\u4E0D\u5230\u5B66\u671F\u672B\uFF09\uFF1B\u77FF\u5DE5\u5BB6\u957F\u4EE3\u8868\u8001\u9B4F\uFF08\u60F3\u8BA9\u5B69\u5B50\u591A\u5B66\u8BA4\u56FE\u7EB8\uFF0C\u8D76\u4E0A\u4ECA\u5E74\u6280\u6821\u62A5\u540D\uFF09\uFF1B\u9A7B\u519B\u5BB6\u5C5E\u4F1A\u4F1A\u957F\uFF08\u60F3\u8BA9\u5B69\u5B50\u6309\u5730\u7403\u6559\u6750\u5B66\uFF0C\u5C06\u6765\u8003\u56DE\u5730\u7403\u7684\u9662\u6821\uFF09"
    <Core>k__BackingField: "\u8001\u5E08\u6BCF\u5468\u8BFE\u65F6\u53EA\u6709\u90A3\u4E48\u591A\uFF0C\u591A\u7ED9\u77FF\u5DE5\u5B69\u5B50\u4E00\u5C0F\u65F6\uFF0C\u9A7B\u519B\u5B69\u5B50\u5C31\u5C11\u4E00\u5C0F\u65F6\uFF0C\u4E24\u8FB9\u7684\"\u5C06\u6765\"\u4E0D\u80FD\u4E00\u8D77\u5151\u73B0\u3002"
    <OptionA>k__BackingField: "\u77FF\u5DE5\u5B69\u5B50\u4F18\u5148\uFF08\u4ECA\u5E74\u6280\u6821\u62A5\u540D\u8D76\u4E0A\uFF0C\u77FF\u533A\u6280\u5E08\u65AD\u5C42\u6709\u671B\u63A5\u4E0A\uFF1B\u9A7B\u519B\u5BB6\u5C5E\u8054\u540D\u5199\u4FE1\u5230\u4E0A\u7EA7\uFF0C\u5B66\u6821\u4E0B\u5B63\u5EA6\u9884\u7B97\u88AB\u51BB\u7ED3\u5F85\u67E5\uFF09"
    <OptionB>k__BackingField: "\u6309\u5730\u7403\u6559\u6750\u8D70\uFF08\u9A7B\u519B\u6EE1\u610F\u3001\u7A0B\u5E8F\u65E0\u61C8\u53EF\u51FB\uFF1B\u77FF\u5DE5\u5B69\u5B50\u9519\u8FC7\u6280\u6821\u62A5\u540D\u7A97\u53E3\uFF0C\u8981\u7B49\u660E\u5E74\uFF0C\u5176\u4E2D\u4E24\u4E2A\u5927\u7684\u8BF4\u4E0D\u60F3\u7B49\u4E86\uFF09"
    <OptionC>k__BackingField: "\u8001\u5E08\u5468\u516D\u52A0\u8BFE\uFF0C\u4ED8\u53CC\u500D\u5DE5\u65F6\u8865\u8D34\uFF08\u4E24\u8FB9\u7684\u8BFE\u90FD\u4FDD\u4F4F\uFF1B\u8001\u5E08\u7684\u795E\u7ECF\u8870\u5F31\u52A0\u91CD\uFF0C\u5B66\u671F\u672B\u9012\u4E86\u63D0\u524D\u79BB\u5C97\u7533\u8BF7\uFF0C\u5B66\u6821\u9762\u4E34\u505C\u8BFE\uFF09"
    <Aftermath>k__BackingField: "\uFF0C\u843D\u9009\u7684\u90A3\u4E00\u8FB9\u4F1A\u6709\u4E00\u4E2A\u5B69\u5B50\u9000\u5B66\u53BB\u77FF\u573A\u5F53\u5B66\u5F92\uFF0C\u9000\u5B66\u62C5\u4FDD\u4E66\u6700\u540E\u8981\u73A9\u5BB6\u7B7E\u5B57\u3002"
    <DelayMonths>k__BackingField: 4
    <WorldAdvances>k__BackingField: 0
  - <Id>k__BackingField: Q03
    <Name>k__BackingField: "\u5371\u5899\u4E0B\u7684\u4E24\u5BB6\u4EBA"
    <Trigger>k__BackingField: "\u8FDE\u96E8\u5929\u8FC7\u540E\uFF0C\u8001\u5C45\u4F4F\u533A\u4E00\u680B\u677F\u623F\u7684\u627F\u91CD\u5899\u88C2\u4E86\uFF0C\u4E24\u6237\u4EBA\u5BB6\u88AB\u5B89\u7F6E\u8FDB\u540C\u4E00\u95F4\u5E94\u6025\u677F\u623F\u6682\u4F4F\u3002"
    <Involved>k__BackingField: "\u8425\u5EFA\u5DE5\u5934\u5DF4\u56FE\uFF08\u60F3\u501F\u6682\u4F4F\u4E24\u6237\u7684\u52B3\u529B\u5FEB\u70B9\u4FEE\u5899\uFF0C\u4EBA\u624B\u4E0D\u591F\uFF09\uFF1B\u7535\u710A\u5DE5\u8001\u7EAA\uFF08\u60F3\u5C3D\u5FEB\u642C\u56DE\u81EA\u5BB6\uFF0C\u4E0D\u80AF\u51FA\u5DE5\uFF0C\u6015\u5BB6\u91CC\u7269\u8D44\u88AB\u4EBA\u987A\u8D70\uFF09\uFF1B\u5C0F\u5356\u90E8\u8001\u677F\u5A18\u5189\u59D0\uFF08\u60F3\u591A\u4F4F\u4E00\u4E2A\u6708\u677F\u623F\uFF0C\u7701\u4E0B\u914D\u7ED9\u70B9\u6570\uFF09"
    <Core>k__BackingField: "\u4FEE\u5899\u8981\u4EBA\u624B\uFF0C\u4EBA\u624B\u53EA\u80FD\u4ECE\u8FD9\u4E24\u5BB6\u91CC\u51FA\uFF0C\u8C01\u51FA\u5DE5\u8C01\u5BB6\u5C31\u6CA1\u4EBA\u770B\u7BA1\uFF0C\u5171\u7528\u4E00\u95F4\u5C4B\u7684\u4E24\u5BB6\u5DF2\u7ECF\u4E3A\u53E3\u7CAE\u548C\u63D2\u5EA7\u5F00\u59CB\u8BB0\u8D26\u3002"
    <OptionA>k__BackingField: "\u4E24\u5BB6\u5408\u4F4F\u516D\u5468\u3001\u8F6E\u6D41\u51FA\u5DE5\uFF08\u5899\u6309\u671F\u4FEE\u597D\uFF1B\u4F46\u4E24\u5BB6\u4E3A\u534A\u888B\u5976\u7C89\u5435\u5230\u52A8\u624B\uFF0C\u6CBB\u5B89\u8BB0\u5F55\u591A\u4E24\u7B14\uFF0C\u88C2\u75D5\u7559\u7740\uFF09"
    <OptionB>k__BackingField: "\u4E00\u5BB6\u4F4F\u677F\u623F\uFF0C\u53E6\u4E00\u5BB6\u4F4F\u4ED3\u5E93\u9694\u95F4\uFF08\u9762\u5B50\u4E0A\u516C\u5E73\uFF1B\u4ED3\u5E93\u4E0D\u4FDD\u6E29\uFF0C\u5189\u59D0\u5BB6\u5B69\u5B50\u591C\u91CC\u7740\u51C9\uFF0C\u533B\u7597\u7AD9\u591A\u4E00\u4E2A\u652F\u6C14\u7BA1\u708E\u75C5\u4F8B\uFF09"
    <OptionC>k__BackingField: "\u4F18\u5148\u4FEE\u8001\u7EAA\u5BB6\u7684\u5899\uFF0C\u677F\u6750\u4ECE\u516C\u5171\u9632\u6D2A\u6599\u91CC\u632A\u7528\uFF08\u8001\u7EAA\u56DB\u5468\u5185\u56DE\u5BB6\uFF1B\u5189\u59D0\u8FD8\u8981\u518D\u7B49\u4E03\u5468\uFF0C\u800C\u6C5B\u671F\u68C0\u67E5\u53D1\u73B0\u9632\u6D2A\u6599\u77ED\u4E86\u6570\u76EE\uFF0C\u77ED\u6599\u90A3\u6BB5\u5824\u575D\u9700\u8981\u8865\u5DE1\uFF09"
    <Aftermath>k__BackingField: "\uFF0C\u96E8\u5B63\u7B2C\u4E8C\u573A\u5927\u96E8\u843D\u5728\u88AB\u632A\u8584\u7684\u90A3\u6BB5\u5824\u575D\u4E0A\uFF0C\u6E17\u6F0F\u62A5\u544A\u548C\u8FFD\u52A0\u4EBA\u624B\u7684\u7533\u8BF7\u540C\u4E00\u5929\u9001\u5230\u73A9\u5BB6\u684C\u4E0A\u3002"
    <DelayMonths>k__BackingField: 2
    <WorldAdvances>k__BackingField: 0
  - <Id>k__BackingField: Q04
    <Name>k__BackingField: "\u964D\u538B\u56DB\u5C0F\u65F6"
    <Trigger>k__BackingField: "\u4E3B\u53D1\u7535\u673A\u7684\u6DA1\u8F6E\u53F6\u7247\u67E5\u51FA\u88C2\u7EB9\uFF0C\u5907\u4EF6\u8239\u8981\u4E94\u4E2A\u6708\u540E\u624D\u5230\uFF0C\u8001\u5DE5\u7A0B\u5E08\u8981\u6C42\u5168\u6B96\u6C11\u5730\u6BCF\u5929\u964D\u538B\u8FD0\u884C\u56DB\u5C0F\u65F6\u3002"
    <Involved>k__BackingField: "\u8001\u5DE5\u7A0B\u5E08\u65B9\u59E8\uFF08\u60F3\u964D\u538B\u4FDD\u6DA1\u8F6E\uFF0C\u522B\u8BA9\u673A\u7EC4\u5E26\u75C5\u6EE1\u8F7D\uFF09\uFF1B\u5236\u51B0\u5382\u8001\u677F\u8042\u5E7F\uFF08\u964D\u538B\u65F6\u6BB5\u51BB\u5E93\u5316\u51BB\uFF0C\u6BCF\u5929\u5012\u6389\u4E00\u6279\u9C7C\u8D27\uFF09\uFF1B\u4E49\u4F53\u6280\u5E08\u5C0F\u8983\uFF08\u964D\u538B\u65F6\u6BB5\u5145\u7535\u6869\u8FC7\u8F7D\uFF0C\u624B\u4E0A\u4E09\u4E2A\u75C5\u4EBA\u7684\u4E49\u4F53\u7B49\u7740\u5145\u7535\uFF09"
    <Core>k__BackingField: "\u964D\u538B\u56DB\u5C0F\u65F6\u7701\u7684\u662F\u673A\u5668\u7684\u547D\uFF0C\u70E7\u7684\u662F\u4E24\u5BB6\u8425\u751F\u7684\u672C\uFF0C\u8C41\u514D\u65F6\u6BB5\u6279\u7ED9\u8C01\u90FD\u7B49\u4E8E\u8BA9\u53E6\u4E00\u5BB6\u9876\u96F7\u3002"
    <OptionA>k__BackingField: "\u7167\u65B9\u59E8\u7684\u65B9\u6848\u5168\u57CE\u964D\u538B\uFF08\u673A\u5668\u7A33\u4F4F\uFF1B\u8042\u5E7F\u6BCF\u5929\u5012\u9C7C\u3001\u5C0F\u8983\u7684\u5145\u7535\u6392\u961F\u5230\u540E\u534A\u591C\uFF0C\u4E24\u5BB6\u5404\u81EA\u5077\u5077\u542F\u7528\u5907\u7528\u7535\u6C60\uFF0C\u7535\u6C60\u63D0\u524D\u62A5\u5E9F\uFF09"
    <OptionB>k__BackingField: "\u8C41\u514D\u5236\u51B0\u5382\u65F6\u6BB5\uFF08\u9C7C\u8D27\u4FDD\u4F4F\u3001\u9547\u4E0A\u6709\u9C7C\u5403\uFF1B\u4E49\u4F53\u5145\u7535\u6869\u70E7\u4E86\u4E24\u5757\u4FDD\u9669\uFF0C\u5C0F\u8983\u6258\u8D70\u79C1\u6E20\u9053\u4E70\u5907\u4EF6\uFF0C\u6EA2\u4EF7\u4ED6\u8981\u73A9\u5BB6\u8BA4\u8D26\uFF09"
    <OptionC>k__BackingField: "\u4ECE\u62C6\u8239\u8D29\u624B\u91CC\u4E70\u4E2A\u4E8C\u624B\u53F6\u7247\u5148\u6362\u4E0A\uFF08\u4E0D\u7528\u964D\u538B\uFF0C\u4E24\u5BB6\u7684\u751F\u610F\u90FD\u4E0D\u52A8\uFF1B\u65B9\u59E8\u62D2\u7EDD\u5728\u9A8C\u6536\u5355\u4E0A\u7B7E\u5B57\uFF0C\u673A\u7EC4\u6B64\u540E\u51FA\u7684\u4EFB\u4F55\u4E8B\u6545\u6CA1\u6709\u6280\u5E08\u80AF\u62C5\u4FDD\uFF09"
    <Aftermath>k__BackingField: "\uFF0C\u5907\u4EF6\u8239\u8FDB\u6E2F\u9A8C\u673A\uFF1A\u8D70
      A \u6216 B \u7684\u673A\u7EC4\u8F74\u627F\u78E8\u635F\u8D85\u9650\uFF0C\u8239\u575E\u62D2\u7EDD\u7EED\u4FDD\uFF1B\u8D70
      C \u7684\u4E8C\u624B\u53F6\u7247\u6070\u597D\u5728\u6E2F\u68C0\u524D\u4E00\u5929\u788E\u88C2\u3002"
    <DelayMonths>k__BackingField: 5
    <WorldAdvances>k__BackingField: 1
  - <Id>k__BackingField: Q05
    <Name>k__BackingField: "\u6362\u4E0D\u52A8\u7684\u767D\u73ED"
    <Trigger>k__BackingField: "\u73A9\u5BB6\u5728\u5468\u4F1A\u4E0A\u8BF4\u8FC7\"\u6392\u73ED\u7684\u4E8B\u6211\u6765\u534F\u8C03\"\uFF0C\u5F53\u665A\u6C34\u5904\u7406\u5382\u591C\u73ED\u5DE5\u5C31\u9012\u4E86\u6362\u73ED\u7533\u8BF7\u2014\u2014\u4ED6\u59BB\u5B50\u4E34\u4EA7\u5728\u5373\uFF0C\u800C\u767D\u73ED\u68C0\u4FEE\u5DE5\u521A\u6512\u6EE1\u73ED\u6B21\u7B49\u7740\u8FDE\u4F11\u3002"
    <Involved>k__BackingField: "\u6C34\u5382\u591C\u73ED\u5DE5\u9648\u6811\uFF08\u60F3\u6362\u767D\u73ED\u966A\u4EA7\uFF0C\u5934\u4E00\u80CE\uFF09\uFF1B\u68C0\u4FEE\u5DE5\u8001\u5173\uFF08\u6512\u4E86\u534A\u5E74\u73ED\uFF0C\u6253\u7B97\u8FDE\u4F11\u5341\u4E8C\u5929\u63A2\u4EB2\uFF09\uFF1B\u8F66\u95F4\u4E3B\u4EFB\u97E9\u59D0\uFF08\u60F3\u8C01\u90FD\u4E0D\u6362\uFF0C\u89C4\u77E9\u4E00\u7834\u5929\u5929\u6709\u4EBA\u6765\u6362\uFF09"
    <Core>k__BackingField: "\u767D\u73ED\u5751\u53EA\u6709\u4E00\u4E2A\uFF0C\u7ED9\u4E86\u966A\u4EA7\u7684\uFF0C\u6512\u4E86\u534A\u5E74\u73ED\u7684\u63A2\u4EB2\u5047\u5C31\u4F5C\u5E9F\uFF0C\u4E24\u4E2A\u7406\u7531\u90FD\u7B49\u4E0D\u8D77\u3002"
    <OptionA>k__BackingField: "\u7279\u6279\u6362\u73ED\uFF08\u9648\u6811\u8D76\u4E0A\u4E86\u5B69\u5B50\u51FA\u751F\uFF1B\u8001\u5173\u5F53\u573A\u6482\u4E86\u5DE5\u5177\uFF0C\u90A3\u534A\u4E2A\u6708\u7684\u68C0\u4FEE\u53EA\u80FD\u9760\u73A9\u5BB6\u7B7E\u5B57\u5F3A\u6392\uFF0C\u5DE5\u5355\u79EF\u538B\uFF09"
    <OptionB>k__BackingField: "\u7EF4\u6301\u539F\u6392\u73ED\uFF08\u8001\u5173\u6309\u8BA1\u5212\u4F11\u5047\u3001\u89C4\u77E9\u6CA1\u7834\uFF1B\u5B69\u5B50\u51FA\u751F\u90A3\u665A\u9648\u6811\u5B88\u5728\u51C0\u5316\u6C60\u8FB9\uFF0C\u4ED6\u4ECE\u6B64\u89C1\u6392\u73ED\u8868\u5C31\u7ED5\u7740\u8D70\uFF0C\u5E74\u5E95\u7533\u8BF7\u8C03\u79BB\u6C34\u5382\uFF09"
    <OptionC>k__BackingField: "\u73A9\u5BB6\u81EA\u5DF1\u9876\u4E00\u4E2A\u767D\u73ED\uFF08\u4E24\u8FB9\u90FD\u6210\u5168\uFF1B\u73A9\u5BB6\u9876\u73ED\u90A3\u665A\u9519\u8FC7\u4E00\u6B21\u5230\u6E2F\u8D27\u7269\u7684\u6E05\u70B9\uFF0C\u77ED\u7F3A\u7684\u4E09\u7BB1\u8D27\u6309\u6D41\u7A0B\u8BB0\u5728\u7B7E\u5B57\u4EBA\u5934\u4E0A\uFF09"
    <Aftermath>k__BackingField: "\u5EF6\u8FDF\uFF1A\u6570\u5468\u540E\uFF0C\u8FD9\u4E8B\u5728\u98DF\u5802\u88AB\u8BB2\u6210\u6BB5\u5B50\u2014\u2014\"\u6709\u4E8B\u627E\u7BA1\u7406\u8005\u9876\u73ED\"\uFF0C\u6B64\u540E\u9694\u4E09\u5DEE\u4E94\u6709\u4EBA\u62FF\u7740\u5404\u79CD\u5BB6\u4E8B\u6765\u627E\u73A9\u5BB6\"\u7279\u6279\"\uFF0C\u97E9\u59D0\u7684\u6392\u73ED\u8868\u53CD\u800C\u66F4\u96BE\u505A\u3002"
    <DelayMonths>k__BackingField: 0
    <WorldAdvances>k__BackingField: 0
  - <Id>k__BackingField: Q06
    <Name>k__BackingField: "\u534A\u7BB1\u8089\u7F50\u5934"
    <Trigger>k__BackingField: "\u8865\u7ED9\u8239\u8BEF\u70B9\u4E8C\u5341\u5929\uFF0C\u98DF\u54C1\u4ED3\u53EA\u5269\u534A\u7BB1\u8089\u7F50\u5934\uFF0C\u518C\u5B50\u4E0A\u5199\u8BE5\u8865\u7ED9\u75C5\u53F7\uFF0C\u4EBA\u5934\u8D26\u4E0A\u5199\u8BE5\u5E73\u5206\u3002"
    <Involved>k__BackingField: "\u98DF\u5802\u4E3B\u53A8\u8001\u7518\uFF08\u60F3\u5168\u7ED9\u75C5\u53F7\u548C\u4F24\u5458\uFF0C\u4EBA\u6709\u70ED\u91CF\u624D\u625B\u5F97\u8FC7\u53BB\uFF09\uFF1B\u914D\u7ED9\u7AD9\u8BB0\u8D26\u5458\u67CF\u59D0\uFF08\u60F3\u4E25\u683C\u5E73\u5206\uFF0C\u8D26\u4E00\u65E6\u7834\u4F8B\u5C31\u518D\u5835\u4E0D\u4E0A\uFF09\uFF1B\u62A4\u58EB\u5C0F\u795D\uFF08\u60F3\u7559\u56DB\u7F50\u7ED9\u672F\u540E\u75C5\u4EBA\u6253\u6D41\u98DF\uFF0C\u6574\u7F50\u5979\u4EEC\u54BD\u4E0D\u4E0B\uFF09"
    <Core>k__BackingField: "\u534A\u7BB1\u7F50\u5934\u7ED9\u4E86\u75C5\u53F7\uFF0C\u5065\u5EB7\u52B3\u529B\u4E0B\u4E2A\u5DE5\u6BB5\u5C31\u6CA1\u529B\u6C14\uFF1B\u5E73\u5206\u4E86\uFF0C\u75C5\u53F7\u6062\u590D\u671F\u62C9\u957F\uFF0C\u75C5\u5E8A\u5468\u8F6C\u4E0D\u5F00\uFF0C\u4E24\u5934\u90FD\u662F\u4EBA\u547D\u8D26\u3002"
    <OptionA>k__BackingField: "\u5168\u6570\u7ED9\u75C5\u53F7\u4F24\u5458\uFF08\u672F\u540E\u4E24\u4EBA\u6309\u65F6\u4E0B\u5E8A\uFF0C\u5E8A\u4F4D\u5468\u8F6C\u56DE\u6765\uFF1B\u5065\u5EB7\u5DE5\u4EBA\u5C11\u4E86\u4E24\u5468\u8364\u8165\uFF0C\u5DE5\u6548\u4E0B\u6ED1\uFF0C\u6708\u5E95\u98DF\u5802\u88AB\u5077\u4E86\u534A\u888B\u9762\u7C89\uFF09"
    <OptionB>k__BackingField: "\u4E25\u683C\u6309\u518C\u5E73\u5206\uFF08\u4EBA\u4EBA\u6709\u4EFD\u3001\u518C\u5B50\u5E72\u51C0\uFF1B\u75C5\u53F7\u70ED\u91CF\u4E0D\u591F\uFF0C\u5176\u4E2D\u4E00\u4E2A\u672F\u540E\u611F\u67D3\uFF0C\u533B\u62A4\u7AD9\u4E3A\u6297\u751F\u7D20\u8FFD\u52A0\u4E86\u8DE8\u7EA7\u7533\u8BF7\uFF09"
    <OptionC>k__BackingField: "\u73A9\u5BB6\u8BA9\u51FA\u81EA\u5DF1\u7684\u4EFD\u989D\u5E76\u5E26\u5934\u52DF\u6350\uFF08\u51D1\u51FA\u7B2C\u4E8C\u4EFD\u75C5\u53F7\u9910\uFF0C\u4E24\u8FB9\u90FD\u7F13\u4E86\u4E00\u53E3\u6C14\uFF1B\u73A9\u5BB6\u7684\u5BA1\u6279\u4FE1\u7528\u88AB\u8BB0\u4E86\u4E00\u7B14\uFF0C\u6B64\u540E\u7269\u8D44\u7533\u8BF7\u8981\u591A\u76D6\u4E00\u9053\u7AE0\uFF09"
    <Aftermath>k__BackingField: "\u5EF6\u8FDF\uFF1A\u6570\u5468\u540E\uFF0C\u8865\u7ED9\u8239\u5230\u6E2F\u8865\u9F50\u5E93\u5B58\uFF0C\u4F46\u8D26\u76EE\u4E0A\u7684\u53E3\u5B50\u7559\u4E0B\u4E86\u2014\u2014\u8D70
      B \u7684\u518C\u5B50\u591A\u51FA\u4E00\u9875\u6279\u6CE8\uFF0C\u8D70 A \u6216
      C \u7684\u6709\u4EBA\u5F00\u59CB\u5B66\u7740\"\u62A5\u75C5\"\u9A97\u52A0\u9910\uFF0C\u8BB0\u8D26\u5458\u628A\u4E09\u540D\u60EF\u72AF\u540D\u5355\u9012\u5230\u73A9\u5BB6\u684C\u4E0A\u3002"
    <DelayMonths>k__BackingField: 0
    <WorldAdvances>k__BackingField: 0
  - <Id>k__BackingField: Q07
    <Name>k__BackingField: "\u575F\u5C71\u5317\u5761"
    <Trigger>k__BackingField: "\u8001\u575F\u5C71\u5317\u5761\u96E8\u540E\u584C\u4E86\u534A\u8FB9\uFF0C\u5357\u5761\u53EA\u5269\u5341\u4E00\u4E2A\u5893\u4F4D\uFF0C\u540C\u4E00\u5468\u91CC\u65E2\u6709\u6559\u6C11\u7684\u4E0B\u846C\u7533\u8BF7\u3001\u53C8\u6709\u77FF\u96BE\u5468\u5E74\u7ACB\u7891\u7684\u7533\u8BF7\u3002"
    <Involved>k__BackingField: "\u795E\u7236\u660E\u53D4\uFF08\u60F3\u5357\u5761\u5168\u7559\u7ED9\u4E0B\u846C\uFF0C\u4EEA\u5F0F\u7684\u4E8B\u4E0D\u80FD\u5C06\u5C31\uFF09\uFF1B\u77FF\u96BE\u9057\u5C5E\u4F1A\u7275\u5934\u4EBA\u8D3A\u5AC2\uFF08\u60F3\u5728\u5357\u5761\u7ACB\u7EAA\u5FF5\u7891\uFF0C\u5360\u4E09\u4E2A\u4F4D\uFF09\uFF1B\u5E9F\u6599\u56DE\u6536\u5546\u9676\u4E5D\uFF08\u60F3\u79DF\u5317\u5761\u584C\u65B9\u533A\u5806\u6599\u4E09\u5E74\uFF0C\u51FA\u4EF7\u662F\u66FF\u5357\u5761\u4FEE\u4E00\u5708\u62A4\u5899\uFF09"
    <Core>k__BackingField: "\u5357\u5761\u7684\u5730\u53EA\u591F\u4E00\u7528\uFF0C\u7EAA\u5FF5\u7891\u7ACB\u4E86\uFF0C\u4E0B\u4E2A\u6708\u6709\u4EBA\u53BB\u4E16\u5C31\u5F97\u5F80\u584C\u65B9\u533A\u57CB\uFF0C\u8C01\u5148\u5360\u53E6\u4E00\u4EF6\u4EBA\u751F\u5927\u4E8B\u5C31\u5F97\u8BA9\u8DEF\u3002"
    <OptionA>k__BackingField: "\u7EAA\u5FF5\u7891\u7ACB\u5357\u5761\uFF08\u9057\u5C5E\u4F1A\u611F\u6FC0\uFF0C\u9547\u6C11\u89C9\u5F97\u516C\u9053\uFF1B\u795E\u7236\u62D2\u7EDD\u4E3B\u6301\u7891\u524D\u4EEA\u5F0F\uFF0C\u5F80\u540E\u884C\u653F\u518D\u60F3\u501F\u6559\u5802\u529E\u8FFD\u60BC\u4F1A\u6CA1\u4E86\u95E8\u8DEF\uFF09"
    <OptionB>k__BackingField: "\u5357\u5761\u5168\u7559\u4E0B\u846C\uFF0C\u7EAA\u5FF5\u7891\u6539\u7ACB\u77FF\u533A\u95E8\u53E3\uFF08\u7A0B\u5E8F\u4E0A\u90FD\u8FC7\u5F97\u53BB\uFF1B\u53EF\u90A3\u662F\u77FF\u573A\u7684\u5730\u76AE\uFF0C\u77FF\u573A\u8981\u6536\u5360\u5730\u7BA1\u7406\u8D39\uFF0C\u9057\u5C5E\u4F1A\u51D1\u4E0D\u51FA\u8FD9\u7B14\u94B1\uFF0C\u7891\u62D6\u6210\u4E86\u4E00\u5806\u77F3\u6599\uFF09"
    <OptionC>k__BackingField: "\u6279\u9676\u4E5D\u79DF\u5317\u5761\uFF0C\u6362\u4ED6\u51FA\u8D44\u52A0\u56FA\u5357\u5761\u3001\u6269\u51FA\u4E8C\u5341\u4E2A\u4F4D\uFF08\u5893\u5730\u7D27\u5F20\u6839\u6CBB\u3001\u516C\u8D26\u4E0D\u82B1\u94B1\uFF1B\u4F46\u9676\u4E5D\u7684\u6599\u5806\u6321\u4F4F\u5317\u5761\u8001\u575F\u7684\u796D\u626B\u8DEF\uFF0C\u796D\u65E5\u5835\u8DEF\u6454\u4E86\u8001\u4EBA\u7684\u4E8B\u8FDF\u65E9\u627E\u4E0A\u95E8\uFF09"
    <Aftermath>k__BackingField: "\uFF0C\u5357\u5761\u8FCE\u6765\u7B2C\u4E00\u4E2A\u65B0\u575F\u4E0B\u846C\u65E5\uFF0C\u5F53\u521D\u6CA1\u7ACB\u6210\u7891\u7684\u9057\u5C5E\u4F1A\u5728\u4EEA\u5F0F\u4E0A\u53D1\u96BE\uFF0C\u628A\u5360\u5730\u8D39\u548C\u62A4\u5899\u7684\u65E7\u8D26\u5F53\u4F17\u7FFB\u51FA\u6765\u3002"
    <DelayMonths>k__BackingField: 6
    <WorldAdvances>k__BackingField: 0
  - <Id>k__BackingField: Q08
    <Name>k__BackingField: "\u7801\u5934\u7B2C\u4E03\u4E2A\u644A\u4F4D"
    <Trigger>k__BackingField: "\u7801\u5934\u6539\u5EFA\u817E\u51FA\u7B2C\u4E03\u4E2A\u644A\u4F4D\uFF0C\u73A9\u5BB6\u4E3B\u6301\u516C\u793A\u671F\uFF0C\u4E09\u5BB6\u5546\u6237\u90FD\u4EA4\u4E86\"\u975E\u6211\u4E0D\u53EF\"\u7684\u6750\u6599\u3002"
    <Involved>k__BackingField: "\u9152\u4FDD\u7F57\u54E5\uFF08\u60F3\u6446\u5916\u5356\u9152\u684C\uFF0C\u7801\u5934\u53F0\u9636\u662F\u4ED6\u53BB\u5E74\u57AB\u8D44\u4FEE\u7684\uFF09\uFF1B\u6742\u8D27\u8D29\u9A6C\u5A76\uFF08\u624B\u91CC\u6709\u524D\u4EFB\u6E2F\u52A1\u5B98\u7684\u53E3\u5934\u627F\u8BFA\uFF0C\u6CA1\u6709\u5B57\u636E\uFF09\uFF1B\u4FEE\u8239\u5320\u963F\u5951\uFF08\u60F3\u5F00\u5DE5\u5177\u94FA\uFF0C\u77FF\u533A\u5DE5\u5177\u8001\u5931\u7A83\u5374\u6CA1\u5904\u4E70\u65B0\u7684\uFF09"
    <Core>k__BackingField: "\u4E09\u4E2A\u7406\u7531\u90FD\u7AD9\u5F97\u4F4F\uFF0C\u644A\u4F4D\u53EA\u6709\u4E00\u4E2A\uFF0C\u7ED9\u8C01\u90FD\u7B49\u4E8E\u5BA3\u5E03\u53E6\u5916\u4E24\u79CD\"\u7406\u7531\"\u4F5C\u5E9F\uFF0C\u5F80\u540E\u7801\u5934\u7684\u89C4\u77E9\u5C31\u6CA1\u4EBA\u4FE1\u4E86\u3002"
    <OptionA>k__BackingField: "\u7ED9\u9152\u4FDD\uFF08\u4FEE\u53F0\u9636\u7684\u4E49\u7406\u6700\u786C\uFF1B\u9A6C\u5A76\u5F53\u8857\u62FF\u65E7\u627F\u8BFA\u5BF9\u8D28\uFF0C\u6E2F\u52A1\u516C\u4FE1\u8A89\u53D7\u635F\uFF0C\u963F\u5951\u5F00\u59CB\u4ECE\u8239\u575E\u987A\u624B\u5E26\u5DE5\u5177\u51FA\u6765\u79C1\u5356\uFF09"
    <OptionB>k__BackingField: "\u7ED9\u9A6C\u5A76\uFF08\u65E7\u627F\u8BFA\u5151\u73B0\u3001\u8BF4\u6CD5\u4E0A\u6700\u987A\uFF1B\u7F57\u54E5\u6536\u56DE\u5BF9\u7801\u5934\u7684\u57AB\u8D44\uFF0C\u53F0\u9636\u518D\u574F\u6CA1\u4EBA\u4FEE\uFF0C\u963F\u5951\u628A\u5DE5\u5177\u94FA\u5F00\u8FDB\u77FF\u533A\uFF0C\u6CBB\u5B89\u591A\u4E00\u7C7B\u5931\u7A83\uFF09"
    <OptionC>k__BackingField: "\u516C\u5F00\u62DB\u6807\u3001\u4EF7\u9AD8\u8005\u5F97\uFF08\u89C4\u77E9\u6700\u5E72\u51C0\u3001\u94B1\u8FDB\u516C\u8D26\uFF1B\u4E09\u5BB6\u90FD\u9A82\u73A9\u5BB6\u773C\u91CC\u53EA\u6709\u94B1\uFF0C\u6700\u7A77\u7684\u963F\u5951\u51FA\u5C40\uFF0C\u77FF\u533A\u4E70\u4E0D\u5230\u65B0\u5DE5\u5177\u7684\u5C40\u9762\u7EE7\u7EED\uFF09"
    <Aftermath>k__BackingField: "\uFF0C\u7801\u5934\u644A\u4F4D\u8D39\u8C03\u6574\u542C\u8BC1\u4F1A\u4E0A\uFF0C\u843D\u9009\u7684\u4E24\u5BB6\u5934\u4E00\u56DE\u8054\u8D77\u624B\u6765\uFF0C\u4EFB\u4F55\u8D39\u7387\u4E0A\u8C03\u90FD\u522B\u60F3\u901A\u8FC7\u3002"
    <DelayMonths>k__BackingField: 3
    <WorldAdvances>k__BackingField: 0
  - <Id>k__BackingField: Q09
    <Name>k__BackingField: "\u780D\u6389\u7684\u5348\u73ED\u8F66"
    <Trigger>k__BackingField: "\u71C3\u6CB9\u914D\u989D\u88AB\u524A\u51CF\u4E00\u6210\uFF0C\u73ED\u8F66\u7EBF\u5FC5\u987B\u780D\u6389\u4E00\u8D9F\uFF0C\u5019\u9009\u7684\u662F\u5348\u73ED\u90A3\u8D9F\u5F80\u8FD4\uFF0C\u6392\u73ED\u65B9\u6848\u9001\u73A9\u5BB6\u88C1\u5B9A\u3002"
    <Involved>k__BackingField: "\u73ED\u8F66\u53F8\u673A\u8001\u83AB\uFF08\u60F3\u4FDD\u4F4F\u591C\u73ED\u524D\u90A3\u8D9F\uFF0C\u4ED6\u5BBF\u820D\u5728\u9547\u53E6\u4E00\u5934\uFF09\uFF1B\u4E09\u73ED\u5012\u5973\u5DE5\u90B5\u6885\uFF08\u4E2D\u5348\u4E0B\u73ED\u8981\u8D76\u56DE\u5BB6\u7ED9\u5B69\u5B50\u70ED\u996D\u518D\u8FD4\u5DE5\uFF09\uFF1B\u5E26\u5B66\u5F92\u7684\u8001\u5E08\u5085\uFF08\u60F3\u8BA9\u5B69\u5B50\u4E2D\u5348\u522B\u5728\u8DEF\u53E3\u7B49\u4E00\u5C0F\u65F6\u7684\u8F66\uFF09"
    <Core>k__BackingField: "\u6CB9\u53EA\u591F\u8DD1\u4E24\u8D9F\uFF0C\u5348\u73ED\u8FD9\u8D9F\u780D\u4E86\uFF0C\u5DE5\u4EBA\u548C\u5B69\u5B50\u603B\u6709\u4E00\u8FB9\u8981\u5728\u8DEF\u4E0A\u591A\u8017\u4E09\u5C0F\u65F6\uFF0C\u8C01\u7684\u65F6\u95F4\u90FD\u4E0D\u662F\u767D\u9001\u7684\u3002"
    <OptionA>k__BackingField: "\u4FDD\u5DE5\u4EBA\u8FD9\u8D9F\uFF0C\u5B69\u5B50\u653E\u5B66\u6CBF\u571F\u8DEF\u6B65\u884C\u56DE\u5BBF\u820D\u533A\uFF08\u4EA7\u7EBF\u4E0D\u7F3A\u4EBA\uFF1B\u96E8\u5B63\u571F\u8DEF\u6ED1\uFF0C\u5B69\u5B50\u6454\u4F24\u662F\u8FDF\u65E9\u7684\u4E8B\uFF0C\u4FEE\u8DEF\u7684\u94B1\u516C\u8D26\u91CC\u6CA1\u6709\uFF09"
    <OptionB>k__BackingField: "\u4FDD\u5B69\u5B50\u8FD9\u8D9F\uFF0C\u5DE5\u4EBA\u4E2D\u5348\u5728\u5382\u91CC\u7B49\u665A\u73ED\uFF08\u5B69\u5B50\u5B89\u5168\u4E86\uFF1B\u98DF\u5802\u5348\u95F4\u4E0D\u5F00\uFF0C\u90B5\u6885\u4EEC\u81EA\u5E26\u51B7\u996D\uFF0C\u80C3\u836F\u9500\u91CF\u5148\u6DA8\uFF0C\u6709\u4EBA\u5F00\u59CB\u642D\u8D70\u79C1\u8D29\u7684\"\u987A\u98CE\u8F66\"\uFF09"
    <OptionC>k__BackingField: "\u780D\u6389\u8001\u83AB\u81EA\u5DF1\u7684\u901A\u52E4\u6BB5\uFF0C\u5B89\u6392\u4ED6\u4F4F\u503C\u66F4\u5BA4\uFF08\u4E24\u8D9F\u90FD\u4FDD\u4F4F\uFF1B\u8001\u83AB\u7684\u59BB\u513F\u6BCF\u5468\u672B\u6A2A\u7A7F\u534A\u4E2A\u77FF\u533A\u6765\u9001\u6362\u6D17\u8863\u7269\uFF0C\u5BBF\u820D\u533A\u4E3A\u6B64\u53C8\u591A\u4E00\u7B14\u626F\u76AE\u8D26\uFF09"
    <Aftermath>k__BackingField: "\uFF0C\u96E8\u5B63\u7B2C\u4E00\u573A\u5927\u96E8\u51FA\u4E86\u4E8B\u2014\u2014\u8D70
      A \u6454\u4F24\u7684\u662F\u653E\u5B66\u5B69\u5B50\uFF0C\u8D70 B \u51FA\u4E8B\u7684\u662F\u642D\u8D70\u79C1\u8D29\u987A\u98CE\u8F66\u7684\u5DE5\u4EBA\uFF0C\u5DE5\u4F24\u5355\u548C\u8FFD\u52A0\u7533\u8BF7\u540C\u4E00\u5929\u538B\u5230\u73A9\u5BB6\u684C\u4E0A\u3002"
    <DelayMonths>k__BackingField: 1
    <WorldAdvances>k__BackingField: 1
  - <Id>k__BackingField: Q10
    <Name>k__BackingField: "\u5BD2\u6F6E\u6765\u4E86\u5148\u4F9B\u8C01"
    <Trigger>k__BackingField: "\u5BD2\u6F6E\u63D0\u524D\u4E8C\u5341\u5929\u767B\u9646\uFF0C\u71C3\u6599\u5E93\u5B58\u53EA\u591F\u6574\u591C\u4F9B\u4E00\u5904\uFF0C\u533B\u7597\u7AD9\u8001\u697C\u548C\u5E7C\u513F\u56ED\u5BBF\u820D\u90FD\u6392\u7B2C\u4E00\uFF0C\u7533\u8BF7\u9001\u5230\u73A9\u5BB6\u684C\u4E0A\u3002"
    <Involved>k__BackingField: "\u540E\u52E4\u9505\u7089\u5DE5\u8001\u4EE3\uFF08\u60F3\u5300\u7740\u70E7\uFF0C\u4E24\u5904\u5404\u4F9B\u4E00\u534A\u6491\u5230\u8865\u7ED9\u8239\uFF09\uFF1B\u5E7C\u513F\u56ED\u4FDD\u80B2\u5458\u5510\u8001\u5E08\uFF08\u5B69\u5B50\u591C\u91CC\u51BB\u9192\u54ED\uFF0C\u8981\u6574\u591C\u4F9B\u6696\uFF09\uFF1B\u533B\u7597\u7AD9\u62A4\u58EB\u957F\uFF08\u672F\u540E\u75C5\u623F\u591C\u95F4\u4E0D\u80FD\u4F4E\u4E8E\u5341\u4E94\u5EA6\uFF0C\u4E0D\u7136\u611F\u67D3\u7387\u62AC\u5934\uFF09"
    <Core>k__BackingField: "\u71C3\u6599\u53EA\u591F\"\u6574\u591C\u4FDD\u4E00\u5904\"\u6216\"\u4E24\u5904\u90FD\u4F4E\u4E8E\u6807\u51C6\"\uFF0C\"\u90FD\u51BB\u7740\"\u548C\"\u53EA\u4FDD\u4E00\u4E2A\"\u4E4B\u95F4\u6CA1\u6709\u8212\u670D\u7684\u9009\u9879\u3002"
    <OptionA>k__BackingField: "\u6574\u591C\u4FDD\u533B\u7597\u7AD9\uFF0C\u5E7C\u513F\u56ED\u52A0\u53D1\u88AB\u8925\u786C\u625B\uFF08\u672F\u540E\u611F\u67D3\u6CA1\u8D77\u6765\uFF1B\u5E7C\u513F\u56ED\u63A5\u8FDE\u75C5\u5012\u56DB\u4E2A\u5B69\u5B50\uFF0C\u5BB6\u957F\u628A\u54B3\u55FD\u5F55\u97F3\u53D1\u904D\u77FF\u533A\uFF09"
    <OptionB>k__BackingField: "\u4E24\u5904\u5300\u7740\u4F9B\u3001\u90FD\u6B20\u7740\u4E00\u70B9\uFF08\u6CA1\u8BA9\u4EFB\u4F55\u4E00\u8FB9\u5D29\u76D8\uFF1B\u62A4\u58EB\u957F\u548C\u5510\u8001\u5E08\u6BCF\u5929\u65E9\u4E0A\u8F6E\u6D41\u6765\u62A5\u6570\u5435\u67B6\uFF0C\u7B2C\u4E09\u5468\u4E24\u5904\u5404\u51FA\u4E00\u8D77\u8F7B\u5EA6\u51BB\u4F24\uFF09"
    <OptionC>k__BackingField: "\u7279\u6279\u52A8\u7528\u8239\u575E\u7684\u5E94\u6025\u7164\uFF08\u4E24\u5904\u90FD\u8FBE\u6807\u3001\u7686\u5927\u6B22\u559C\uFF1B\u4F46\u90A3\u662F\u8239\u575E\u7684\u4FDD\u9669\u50A8\u5907\uFF0C\u8239\u575E\u957F\u8981\u73A9\u5BB6\u7B7E\u4E2A\u4EBA\u62C5\u4FDD\u5355\uFF0C\u70E7\u6389\u7684\u6BCF\u4E00\u5428\u90FD\u8BB0\u5728\u73A9\u5BB6\u540D\u4E0B\uFF09"
    <Aftermath>k__BackingField: "\uFF0C\u8865\u7ED9\u8239\u5E26\u6765\u65B0\u71C3\u6599\u5F00\u59CB\u6E05\u8D26\uFF0C\u8D70
      C \u7684\u62C5\u4FDD\u5355\u5151\u6210\u5B9E\u7F3A\uFF0C\u4ECE\u73A9\u5BB6\u540D\u4E0B\u914D\u989D\u91CC\u6263\u2014\u2014\u6263\u591A\u5C11\u7531\u8239\u575E\u957F\u6838\u6570\uFF0C\u4ED6\u8BF4\u4E86\u7B97\u3002"
    <DelayMonths>k__BackingField: 2
    <WorldAdvances>k__BackingField: 0
  - <Id>k__BackingField: Q11
    <Name>k__BackingField: "\u4F11\u6E14\u56DB\u5341\u5929"
    <Trigger>k__BackingField: "\u6CB3\u53E3\u6E14\u83B7\u8FDE\u7EED\u4E09\u4E2A\u6708\u51CF\u4EA7\uFF0C\u6E14\u653F\u5EFA\u8BAE\u4F11\u6E14\u56DB\u5341\u5929\uFF0C\u53EF\u4F11\u6E14\u671F\u7684\u53E3\u7CAE\u548C\u8FD8\u8D37\u6CA1\u4EBA\u7ED9\u8BF4\u6CD5\uFF0C\u88C1\u5B9A\u6743\u843D\u5728\u73A9\u5BB6\u624B\u91CC\u3002"
    <Involved>k__BackingField: "\u8001\u6E14\u6C11\u97E9\u4F2F\uFF08\u60F3\u4F11\u6E14\uFF0C\u518D\u635E\u4E0B\u53BB\u9C7C\u82D7\u5C31\u7EDD\u4E86\u6839\uFF09\uFF1B\u6E14\u8239\u8239\u4E3B\u90B1\u6EE1\uFF08\u8239\u8D37\u6309\u6708\u6263\uFF0C\u4F11\u6E14\u56DB\u5341\u5929\u4ED6\u7F13\u4E0D\u8FC7\u6765\uFF09\uFF1B\u6E2F\u53E3\u88C5\u5378\u961F\u961F\u957F\u795D\u5927\uFF08\u4F11\u6E14\u671F\u6CA1\u9C7C\u53EF\u5378\uFF0C\u4E34\u65F6\u5DE5\u8981\u6563\u4F19\uFF09"
    <Core>k__BackingField: "\u4E0D\u4F11\u6E14\u660E\u5E74\u5927\u5BB6\u90FD\u6CA1\u9C7C\u5403\uFF0C\u53EF\u4F11\u6E14\u7684\u56DB\u5341\u5929\u91CC\u8239\u8D37\u3001\u5DE5\u94B1\u90FD\u662F\u773C\u524D\u7684\u7A9F\u7ABF\uFF0C\u8FDC\u8D26\u548C\u8FD1\u8D26\u6324\u540C\u4E00\u4E2A\u94B1\u5305\u3002"
    <OptionA>k__BackingField: "\u5F3A\u5236\u4F11\u6E14\u56DB\u5341\u5929\uFF0C\u7F3A\u53E3\u516C\u8D26\u57AB\u4E00\u534A\uFF08\u9C7C\u82D7\u4FDD\u4F4F\u3001\u660E\u5E74\u6709\u76FC\u5934\uFF1B\u516C\u8D26\u5403\u7D27\uFF0C\u4E0B\u4E00\u7B14\u8BBE\u5907\u91C7\u8D2D\u6401\u7F6E\uFF0C\u4E34\u65F6\u5DE5\u6563\u4F19\uFF0C\u88C5\u5378\u961F\u7F3A\u5458\u4E09\u4E2A\u6708\uFF09"
    <OptionB>k__BackingField: "\u4F11\u6E14\u7F29\u6210\u4E8C\u5341\u5929\uFF0C\u8239\u4E3B\u81EA\u8BA4\u4E00\u534A\u635F\u5931\uFF08\u8D26\u9762\u597D\u770B\u3001\u4E24\u65B9\u90FD\u8BA9\u4E86\u6B65\uFF1B\u90B1\u6EE1\u5356\u4E86\u4E00\u6761\u8239\u8FD8\u8D37\uFF0C\u97E9\u4F2F\u5ACC\u6CA1\u4F11\u591F\uFF0C\u660E\u5E74\u9C7C\u83B7\u4F9D\u7136\u662F\u672A\u77E5\u6570\uFF09"
    <OptionC>k__BackingField: "\u4E0D\u4F11\u6E14\uFF0C\u6539\u5F81\u6E14\u83B7\u7A0E\u5B58\u4F5C\u80B2\u82D7\u57FA\u91D1\uFF08\u773C\u524D\u4EBA\u4EBA\u6709\u996D\u5403\uFF1B\u97E9\u4F2F\u5E26\u4E09\u6761\u8239\u6302\u65D7\u505C\u6355\uFF0C\u6E2F\u53E3\u5835\u4E86\u4E00\u6574\u5929\uFF0C\u7A0E\u57FA\u53CD\u800C\u7F29\u6C34\uFF09"
    <Aftermath>k__BackingField: "\uFF0C\u4F11\u6E14\u7ED3\u675F\u540E\u7684\u7B2C\u4E00\u4E2A\u6E14\u6C5B\u89C1\u5206\u6653\u2014\u2014\u8D70
      A \u7684\u9C7C\u56DE\u6765\u4E86\u4F46\u5378\u8D27\u7684\u4EBA\u624B\u6CA1\u8865\u4E0A\uFF0C\u9C7C\u70C2\u5728\u7801\u5934\uFF1B\u8D70
      B \u6216 C \u7684\u6E14\u6C5B\u7A00\u8584\uFF0C\u9C7C\u4EF7\u6DA8\u5230\u5185\u9646\u9547\u90FD\u6765\u62A2\u8D2D\u3002"
    <DelayMonths>k__BackingField: 4
    <WorldAdvances>k__BackingField: 1
  - <Id>k__BackingField: Q12
    <Name>k__BackingField: "\u8584\u5899\u4E24\u8FB9"
    <Trigger>k__BackingField: "\u5408\u5BBF\u533A\u4E24\u6237\u5171\u7528\u4E00\u9762\u8584\u5899\uFF0C\u591C\u73ED\u710A\u5DE5\u51CC\u6668\u56DE\u5C4B\u8981\u7761\uFF0C\u9694\u58C1\u53CC\u804C\u5DE5\u5BB6\u5EAD\u53EA\u6709\u767D\u5929\u90A3\u4E24\u5C0F\u65F6\u80FD\u667E\u6652\u6572\u6253\u88AB\u8925\uFF0C\u6295\u8BC9\u540C\u65F6\u9012\u5230\u73A9\u5BB6\u684C\u4E0A\u3002"
    <Involved>k__BackingField: "\u591C\u73ED\u710A\u5DE5\u9C81\u5E08\u5085\uFF08\u51CC\u6668\u56DB\u70B9\u5165\u7761\u662F\u5929\u5927\u7684\u4E8B\uFF0C\u5DF2\u7ECF\u4E09\u5929\u6CA1\u7761\u6574\u89C9\uFF09\uFF1B\u53CC\u804C\u5DE5\u6BCD\u4EB2\u90C1\u59D0\uFF08\u767D\u5929\u90A3\u4E24\u5C0F\u65F6\u662F\u5168\u5BB6\u7684\u667E\u6652\u65F6\u95F4\uFF0C\u665A\u4E0A\u8FD8\u8981\u54C4\u5B69\u5B50\u7761\uFF09\uFF1B\u5408\u5BBF\u533A\u697C\u957F\uFF08\u60F3\u5404\u9000\u4E00\u6B65\u606F\u4E8B\u5B81\u4EBA\uFF0C\u4F46\u4E24\u8FB9\u90FD\u89C9\u5F97\u81EA\u5DF1\u5728\u8BA9\uFF09"
    <Core>k__BackingField: "\u4E00\u65B9\u7684\u6DF1\u591C\u5C31\u662F\u53E6\u4E00\u65B9\u7684\u767D\u5929\uFF0C\u540C\u4E00\u9762\u5899\u7684\u65F6\u95F4\u8868\u600E\u4E48\u6392\u90FD\u6709\u4E00\u8FB9\u8981\u5403\u4E8F\u3002"
    <OptionA>k__BackingField: "\u5212\u9759\u97F3\u65F6\u6BB5\uFF0C\u591C\u95F4\u7981\u97F3\u54CD\u3001\u767D\u5929\u9650\u5B9A\u6572\u6253\u4E24\u5C0F\u65F6\uFF08\u4E24\u8FB9\u5404\u8BA9\u4E09\u5C0F\u65F6\uFF1B\u90FD\u5ACC\u4E8F\uFF0C\u9694\u4E09\u5DEE\u4E94\u6765\u8981\u6C42\"\u91CD\u65B0\u5212\u7EBF\"\uFF0C\u8C03\u89E3\u8BB0\u5F55\u8D8A\u79EF\u8D8A\u539A\uFF09"
    <OptionB>k__BackingField: "\u7ED9\u5176\u4E2D\u4E00\u6237\u6362\u5BBF\u820D\uFF08\u5F53\u4E0B\u6E05\u51C0\uFF1B\u6362\u51FA\u53BB\u7684\u90A3\u6237\u79BB\u73ED\u8F66\u7AD9\u8FDC\u4E86\u4E8C\u5341\u5206\u949F\uFF0C\u7B49\u4E8E\u62FF\u901A\u52E4\u8865\u507F\u7761\u7720\uFF0C\u800C\u4E14\u65B0\u90BB\u5C45\u7684\u65B0\u77DB\u76FE\u5DF2\u5728\u915D\u917F\uFF09"
    <OptionC>k__BackingField: "\u516C\u8D39\u7ED9\u8FD9\u9762\u5899\u52A0\u9694\u97F3\u677F\uFF08\u6839\u6CBB\uFF0C\u4E24\u6237\u90FD\u670D\u6C14\uFF1B\u6750\u6599\u4ECE\u4E0B\u6279\u4F4F\u623F\u7EF4\u4FEE\u9884\u7B97\u91CC\u51FA\uFF0C\u6392\u5728\u540E\u9762\u7684\u90A3\u6237\u6F0F\u96E8\u7EF4\u4FEE\u987A\u5EF6\u4E00\u4E2A\u6708\uFF09"
    <Aftermath>k__BackingField: "\u5EF6\u8FDF\uFF1A\u6570\u5468\u540E\uFF0C\u65E0\u8BBA\u9009\u54EA\u6761\uFF0C\u8FD9\u5BF9\u90BB\u5C45\u90FD\u4F1A\u518D\u4E3A\u4E00\u4EF6\u5C0F\u4E8B\u56DE\u5230\u73A9\u5BB6\u684C\u4E0A\u2014\u2014\u4E0A\u6B21\u7684\u88C1\u51B3\u4F1A\u88AB\u53CC\u65B9\u5404\u5F15\u7528\u4E00\u534A\uFF0C\u800C\u697C\u957F\u4ECE\u6B64\u51E1\u4E8B\u90FD\u5F80\u73A9\u5BB6\u8FD9\u91CC\u63A8\u3002"
    <DelayMonths>k__BackingField: 0
    <WorldAdvances>k__BackingField: 1
